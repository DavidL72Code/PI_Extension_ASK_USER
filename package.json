{
  "name": "pi-ask-user",
  "version": "0.1.0",
  "description": "Pi extension that adds an ask_user tool: the agent asks one decision question through Pi's built-in select/input dialogs.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/fake-test/*.test.ts",
    "test:batch": "node test/fake-test/batch.ts",
    "test:random": "node test/fake-test/random.ts",
    "test:real": "node test/real-test/real-dialogs.mjs",
    "test:live-check": "node test/real-test/live-rpc-check.mjs",
    "test:live-prompts": "node test/real-test/live-prompt-batch.mjs",
    "test:live-answers": "node test/real-test/live-answers.mjs",
    "test:live-similar": "node test/real-test/live-similar.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "24.10.1",
    "typebox": "1.3.27",
    "typescript": "6.0.3"
  }
}
