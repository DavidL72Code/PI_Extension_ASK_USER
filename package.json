{
  "name": "pi-ask-user",
  "version": "0.1.0",
  "description": "Pi extension that adds an ask_user tool: the agent asks one decision question through Pi's built-in select/input dialogs.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:batch": "node test/batch.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "24.10.1",
    "typebox": "1.3.27",
    "typescript": "6.0.3"
  }
}
